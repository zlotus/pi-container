# Provision this exact identity and Gateway URL first; see README for the command.
CONTROL_PLANE_URL=ws://127.0.0.1:3000/api/workers/connect
WORKER_ID=worker-a
WORKER_TOKEN=replace-with-the-provisioned-token
WORKER_GATEWAY_TOKEN=replace-with-the-independent-gateway-token
WORKER_MAX_WORKSPACES=4

# This is the Worker's local bind address. Loopback is safe for same-host
# development; a remote Worker may bind 0.0.0.0 on a protected LAN/VPN.
# Separately register the Control Plane-reachable address (never remote
# loopback) as WORKER_GATEWAY_BASE_URL via worker:provision. Configure both TLS
# paths to enable native HTTPS.
WORKER_GATEWAY_HOST=127.0.0.1
WORKER_GATEWAY_PORT=3100
# WORKER_GATEWAY_TLS_CERT_PATH=/etc/agent-runtime/worker-gateway.crt
# WORKER_GATEWAY_TLS_KEY_PATH=/etc/agent-runtime/worker-gateway.key

# Must exactly match the Control Plane Workspace base origin. In multi-host
# acceptance this can be http://agent.192.168.1.124.nip.io:3001. The Worker
# uses its hostname portion for each pi-web instance's exact allowed-host setting.
WORKSPACE_BASE_URL=http://agent.localhost:3001

WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_RECONNECT_INITIAL_MS=1000
WORKER_RECONNECT_MAX_MS=30000

# Must exactly match the locally built Phase 3 image and Control Plane default.
RUNTIME_IMAGE=agent-runtime:phase3-minimal
RUNTIME_VERSION=phase-3

# Worker-only access to the local Docker Engine and managed persistent root.
# The Docker socket is never mounted into a Workspace Container.
DOCKER_SOCKET_PATH=/var/run/docker.sock
WORKER_MANAGED_ROOT=/var/lib/agent-runtime

WORKSPACE_CPU_COUNT=2
WORKSPACE_MEMORY_BYTES=4294967296
WORKSPACE_PIDS_LIMIT=512
WORKSPACE_UID=1000
WORKSPACE_GID=1000
WORKSPACE_START_TIMEOUT_MS=60000

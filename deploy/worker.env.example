# Provision this exact identity first with `WORKER_ID=worker-a pnpm worker:provision`.
CONTROL_PLANE_URL=ws://127.0.0.1:3000/api/workers/connect
WORKER_ID=worker-a
WORKER_TOKEN=replace-with-the-provisioned-token
WORKER_MAX_WORKSPACES=4

WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_RECONNECT_INITIAL_MS=1000
WORKER_RECONNECT_MAX_MS=30000

# Must exactly match the locally built Phase 3 image and Control Plane default.
RUNTIME_IMAGE=agent-runtime:phase3-minimal
RUNTIME_VERSION=phase-3

# Worker-only access to the local Docker Engine and managed persistent root.
# The Docker socket is never mounted into a Workspace Container.
DOCKER_SOCKET_PATH=/var/run/docker.sock
WORKER_MANAGED_ROOT=/var/lib/agent-runtime

WORKSPACE_CPU_COUNT=2
WORKSPACE_MEMORY_BYTES=4294967296
WORKSPACE_PIDS_LIMIT=512
WORKSPACE_UID=1000
WORKSPACE_GID=1000
WORKSPACE_START_TIMEOUT_MS=60000

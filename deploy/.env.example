POSTGRES_DB=agent_runtime
POSTGRES_USER=agent_runtime
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Used when the control plane runs on the host.
DATABASE_URL=postgres://agent_runtime:local-development-only@127.0.0.1:5432/agent_runtime
HOST=127.0.0.1
PORT=3000
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3001

# Prometheus metrics (specs.md Phase 17, docs/observability-runbook.md). Leave METRICS_PORT
# empty to disable. The listener is separate from the Portal API and the Workspace Gateway,
# always needs the Bearer token in METRICS_TOKEN_FILE (0600; tools/dev/init-metrics-token.sh)
# and never binds a wildcard address.
METRICS_HOST=127.0.0.1
METRICS_PORT=
METRICS_TOKEN_FILE=

# Structured JSON logs on stdout. LOG_FORMAT=pretty needs the development dependencies.
LOG_LEVEL=info
LOG_FORMAT=json

# Portal/API session security. PORTAL_ORIGIN is the browser's canonical origin,
# not a bind address. Add optional comma-separated exact HTTP(S) origins for
# other trusted entry points; wildcards and * are rejected.
PORTAL_ORIGIN=http://127.0.0.1:5173
PORTAL_ALLOWED_ORIGINS=
# Platform addresses no egress whitelist may open (comma-separated IPv4 or CIDR); the
# DATABASE_URL host is added automatically. See docs/egress-runbook.md.
PLATFORM_EGRESS_PROTECTED=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Generic OIDC. The exact callback is <PORTAL_ORIGIN>/auth/oidc/callback.
# JIT remains opt-in; allowed domains are exact, comma-separated domains.
# Keep callback query strings, request bodies, and auth headers out of proxy logs.
AUTH_OIDC_ENABLED=false
AUTH_OIDC_PROVIDER_ID=generic-oidc
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_AUTO_PROVISION=false
AUTH_OIDC_ALLOWED_DOMAINS=

# Phase 11 generic OAuth2 + UserInfo compatibility. This is independent from
# OIDC and does not weaken OIDC validation. The exact callback is
# <PORTAL_ORIGIN>/auth/oauth2/callback. Dot-separated mappings support nested
# JSON such as attributes.workcode and attributes.email.
AUTH_OAUTH2_ENABLED=false
AUTH_OAUTH2_PROVIDER_ID=generic-oauth2
AUTH_OAUTH2_AUTHORIZATION_URL=
AUTH_OAUTH2_TOKEN_URL=
AUTH_OAUTH2_USERINFO_URL=
# Prefer bearer. Use query only for a non-standard profile endpoint that
# requires ?access_token=... (for example, a directly connected Weaver API).
# Every upstream proxy/API gateway must also suppress the full query string.
AUTH_OAUTH2_USERINFO_TOKEN_METHOD=bearer
AUTH_OAUTH2_CLIENT_ID=
AUTH_OAUTH2_CLIENT_SECRET=
AUTH_OAUTH2_SCOPE=
AUTH_OAUTH2_SUBJECT_FIELD=sub
AUTH_OAUTH2_USERNAME_FIELD=
AUTH_OAUTH2_EMAIL_FIELD=
AUTH_OAUTH2_DISPLAY_NAME_FIELD=
AUTH_OAUTH2_AUTO_PROVISION=false
AUTH_OAUTH2_ALLOWED_DOMAINS=

# Single-host browser entry for <workspace-id>.agent.localhost. Multi-host
# acceptance needs a client-resolvable wildcard, for example
# http://agent.192.168.1.124.nip.io:3001. Production uses internal wildcard
# DNS/certificate and forwards that host to GATEWAY_HOST:GATEWAY_PORT.
WORKSPACE_BASE_URL=http://agent.localhost:3001
WORKSPACE_SESSION_EXCHANGE_TTL_MS=60000

# Per-Worker data-plane credentials. Values come from worker:provision or
# worker:configure-gateway and must match that Worker's private environment.
WORKER_GATEWAY_TOKENS_JSON={}

# Worker control channel timing. Defaults are shown explicitly.
WORKER_OFFLINE_AFTER_MS=35000
WORKER_STATUS_SWEEP_MS=5000
WORKER_COMMAND_TIMEOUT_MS=15000

# Phase 7 Runtime Toolchain and per-Workspace resource limits.
DEFAULT_RUNTIME_IMAGE=agent-runtime:phase7-toolchain
WORKSPACE_CPU_COUNT=2
WORKSPACE_MEMORY_BYTES=4294967296
WORKSPACE_PIDS_LIMIT=512
# Data-project disk limit for new Workspaces, and the most an administrator may set
# per Workspace (docs/storage-runbook.md).
WORKSPACE_DISK_LIMIT_BYTES=21474836480
WORKSPACE_DISK_LIMIT_MAX_BYTES=1099511627776

# Login protection (docs/authentication-runbook.md). X-Forwarded-For is believed only
# from AUTH_TRUSTED_PROXIES; the development Vite proxy runs on loopback. The account-wide
# lock does not apply from AUTH_TRUSTED_NETWORKS (break-glass; use the management network
# in production). Thresholds count failures per 15 min (account+address, address) and
# per hour (account); SSO starts per address per 10 min.
AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128
AUTH_TRUSTED_NETWORKS=127.0.0.1/32,::1/128
AUTH_LOCKOUT_ACCOUNT_IP_THRESHOLD=5
AUTH_LOCKOUT_IP_THRESHOLD=20
AUTH_LOCKOUT_ACCOUNT_THRESHOLD=50
AUTH_SSO_START_LIMIT=30

# Platform model access (specs.md Phase 16, docs/model-gateway-runbook.md). Empty disables it.
# The master key is the LiteLLM one; it never leaves the Control Plane.
MODEL_GATEWAY_ADMIN_URL=
MODEL_GATEWAY_MASTER_KEY=
MODEL_GATEWAY_CATALOG_FILE=
# Per-user budget in USD per period (empty = unlimited) and the per-key request limit.
MODEL_GATEWAY_USER_BUDGET_USD=
MODEL_GATEWAY_BUDGET_DURATION=30d
MODEL_GATEWAY_KEY_RPM=60

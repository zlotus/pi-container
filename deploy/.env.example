POSTGRES_DB=agent_runtime
POSTGRES_USER=agent_runtime
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Used when the control plane runs on the host.
DATABASE_URL=postgres://agent_runtime:local-development-only@127.0.0.1:5432/agent_runtime
HOST=127.0.0.1
PORT=3000

# Portal/API session security. Use a new random secret outside development.
PORTAL_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Worker control channel timing. Defaults are shown explicitly.
WORKER_OFFLINE_AFTER_MS=35000
WORKER_STATUS_SWEEP_MS=5000
WORKER_COMMAND_TIMEOUT_MS=15000

# Phase 3 Minimal Runtime and per-Workspace resource limits.
DEFAULT_RUNTIME_IMAGE=agent-runtime:phase3-minimal
WORKSPACE_CPU_COUNT=2
WORKSPACE_MEMORY_BYTES=4294967296
WORKSPACE_PIDS_LIMIT=512

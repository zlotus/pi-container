POSTGRES_DB=agent_runtime
POSTGRES_USER=agent_runtime
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Used when the control plane runs on the host.
DATABASE_URL=postgres://agent_runtime:local-development-only@127.0.0.1:5432/agent_runtime
HOST=127.0.0.1
PORT=3000
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3001

# Portal/API session security. PORTAL_ORIGIN is the browser's canonical origin,
# not a bind address. Use a new random secret outside development.
PORTAL_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Single-host browser entry for <workspace-id>.agent.localhost. Multi-host
# acceptance needs a client-resolvable wildcard, for example
# http://agent.192.168.1.124.nip.io:3001. Production uses internal wildcard
# DNS/certificate and forwards that host to GATEWAY_HOST:GATEWAY_PORT.
WORKSPACE_BASE_URL=http://agent.localhost:3001
WORKSPACE_SESSION_EXCHANGE_TTL_MS=60000

# Per-Worker data-plane credentials. Values come from worker:provision or
# worker:configure-gateway and must match that Worker's private environment.
WORKER_GATEWAY_TOKENS_JSON={}

# Worker control channel timing. Defaults are shown explicitly.
WORKER_OFFLINE_AFTER_MS=35000
WORKER_STATUS_SWEEP_MS=5000
WORKER_COMMAND_TIMEOUT_MS=15000

# Phase 3 Minimal Runtime and per-Workspace resource limits.
DEFAULT_RUNTIME_IMAGE=agent-runtime:phase3-minimal
WORKSPACE_CPU_COUNT=2
WORKSPACE_MEMORY_BYTES=4294967296
WORKSPACE_PIDS_LIMIT=512

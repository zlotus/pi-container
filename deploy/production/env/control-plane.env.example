# Control Plane configuration (non-secret) -> /etc/agent-runtime/control-plane.env
# root:agent-runtime-cp 0640. Secrets live in control-plane.secrets.env (init-secrets.sh).
# Format for systemd EnvironmentFile and Node --env-file alike: KEY=value, one per line,
# no quotes, no trailing comments. See docs/deployment.md.

# Listeners: loopback only; nginx is the only entry point (specs.md Phase 19.3).
HOST=127.0.0.1
PORT=3000
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3001
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
METRICS_TOKEN_FILE=/etc/agent-runtime/metrics.token

# Production applies migrations only with `agent-runtime-ctl db:migrate`, after a backup.
DATABASE_MIGRATE_ON_START=false

# Public names (docs/tls-and-dns.md). Workspace hosts are <workspace-id>.<WORKSPACE_BASE_URL host>.
PORTAL_ORIGIN=https://portal.example.internal
WORKSPACE_BASE_URL=https://agent.example.internal
SESSION_COOKIE_SECURE=true
# nginx runs on this host and overwrites X-Forwarded-For; add a load balancer in front if any.
AUTH_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Management networks exempt from the account-wide login lock (break-glass, Phase 15.9).
AUTH_TRUSTED_NETWORKS=127.0.0.1/32,::1/128

# Addresses no egress whitelist may open: this host's addresses as Workers see them, the
# database, the model gateway. Workers add CONTROL_PLANE_URL and the gateway automatically.
PLATFORM_EGRESS_PROTECTED=

# Runtime image for new Workspaces and the target of "upgrade" (offered by every schedulable Worker).
DEFAULT_RUNTIME_IMAGE=agent-runtime:2026.10-pi1.1

# Platform models through LiteLLM on loopback (deploy/production/compose.yml, Phase 16).
# Leave all three empty to run without platform models (also remove the master key secret).
MODEL_GATEWAY_ADMIN_URL=http://127.0.0.1:4400
MODEL_GATEWAY_CATALOG_FILE=/etc/agent-runtime/model-gateway/catalog.json
MODEL_GATEWAY_USER_BUDGET_USD=
MODEL_GATEWAY_BUDGET_DURATION=30d

# Idle stop (Phase 18.5): empty = off; whole hours, e.g. 24.
IDLE_STOP_AFTER_HOURS=

# Optional enterprise login (docs/authentication-runbook.md); client secrets go in the secrets file.
AUTH_OIDC_ENABLED=false
AUTH_OAUTH2_ENABLED=false

LOG_LEVEL=info
LOG_FORMAT=json

# Worker configuration -> /etc/agent-runtime/worker.env, root:agent-runtime 0640 (it holds
# the Worker's two tokens). Format: KEY=value, one per line, no quotes. See docs/deployment.md.

# The Control Plane's internal entry (nginx 8443) and this Worker's identity and tokens, as
# printed once by `agent-runtime-ctl worker:provision` on the Control Plane host.
CONTROL_PLANE_URL=wss://cp.example.internal:8443/api/workers/connect
WORKER_ID=worker-1
WORKER_TOKEN=
WORKER_GATEWAY_TOKEN=
WORKER_MAX_WORKSPACES=8

# Worker Gateway: TLS on the address the Control Plane reaches (registered as
# WORKER_GATEWAY_BASE_URL https://<that address>:3100); firewall it to the Control Plane host.
WORKER_GATEWAY_HOST=0.0.0.0
WORKER_GATEWAY_PORT=3100
WORKER_GATEWAY_TLS_CERT_PATH=/etc/agent-runtime/tls/worker-gateway.crt
WORKER_GATEWAY_TLS_KEY_PATH=/etc/agent-runtime/tls/worker-gateway.key

# Exactly the Control Plane's WORKSPACE_BASE_URL.
WORKSPACE_BASE_URL=https://agent.example.internal

# Runtime images offered here, as printed by `agent-runtime-image load|verify` (required).
RUNTIME_IMAGES=agent-runtime:2026.10-pi1.1@sha256:<digest>

# Independent XFS with prjquota (docs/storage-runbook.md); plain path characters only.
WORKER_MANAGED_ROOT=/var/lib/agent-runtime

# Platform models: the Control Plane's internal gateway entry (nginx 8444).
WORKER_MODEL_GATEWAY_URL=https://cp.example.internal:8444
WORKER_MODEL_RELAY_PORT=3101

# Other platform addresses Workspaces must never reach (comma-separated IPv4 or CIDR).
WORKER_EGRESS_PROTECTED=

LOG_LEVEL=info
LOG_FORMAT=json

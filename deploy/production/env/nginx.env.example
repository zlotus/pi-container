# nginx settings -> /etc/agent-runtime/nginx.env (read by deploy/production/compose.yml).
# AR_* are substituted into the nginx template (specs.md Phase 19.6).

# Address(es) users reach: the host's address in the user network (one address).
AR_PUBLIC_LISTEN=192.0.2.10
# Address Workers reach for 8443 (control channel) and 8444 (model gateway).
AR_INTERNAL_LISTEN=192.0.2.10
AR_PORTAL_HOST=portal.example.internal
AR_WORKSPACE_DOMAIN=agent.example.internal
# The Control Plane's loopback ports (control-plane.env PORT, GATEWAY_PORT) and LiteLLM's.
AR_CONTROL_PLANE_PORT=3000
AR_GATEWAY_PORT=3001
AR_LITELLM_PORT=4400

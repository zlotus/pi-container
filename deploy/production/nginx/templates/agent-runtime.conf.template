# nginx in front of the Control Plane (specs.md Phase 19.6). Rendered by the nginx image at
# container start: ${AR_*} come from the compose environment (NGINX_ENVSUBST_FILTER=^AR_),
# every other $variable is nginx's own. Certificates live in /etc/agent-runtime/tls
# (docs/tls-and-dns.md). Requirements for another proxy: docs/deployment.md.
#
#   :443   ${AR_PORTAL_HOST}            Portal (static, SPA fallback) + /api, /auth -> Control Plane
#   :443   *.${AR_WORKSPACE_DOMAIN}     Workspaces -> Workspace Gateway (Host kept, streaming)
#   :8443  internal, Worker network     /api/workers/connect only -> Control Plane
#   :8444  internal, Worker network     model inference paths only -> LiteLLM

map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      close;
}

# No query strings, cookies, Authorization or Referer in the access log (platform logging
# rule; OAuth/OIDC callbacks carry codes in the query). Used by snippets/logging.conf.
log_format agent_runtime escape=json
  '{"time":"$time_iso8601","client":"$remote_addr","server":"$server_name","host":"$host",'
  '"method":"$request_method","path":"$uri","status":$status,"bytes":$body_bytes_sent,'
  '"duration":$request_time,"upstream_status":"$upstream_status"}';

server_tokens off;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:agent_runtime_tls:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# HTTP only redirects to HTTPS.
server {
  listen ${AR_PUBLIC_LISTEN}:80 default_server;
  server_name _;
  include /opt/agent-runtime/current/deploy/nginx/snippets/logging.conf;
  return 301 https://$host$request_uri;
}

# Unknown names get no certificate and no response.
server {
  listen ${AR_PUBLIC_LISTEN}:443 ssl default_server;
  server_name _;
  include /opt/agent-runtime/current/deploy/nginx/snippets/logging.conf;
  ssl_reject_handshake on;
}

server {
  listen ${AR_PUBLIC_LISTEN}:443 ssl;
  http2 on;
  server_name ${AR_PORTAL_HOST};
  include /opt/agent-runtime/current/deploy/nginx/snippets/logging.conf;
  ssl_certificate /etc/agent-runtime/tls/public.crt;
  ssl_certificate_key /etc/agent-runtime/tls/public.key;

  # The active release; the relative `current` link resolves inside the mount, so switching
  # releases needs only `nginx -s reload`, not a new container.
  root /opt/agent-runtime/current/portal;
  set $workspace_forms "https://*.${AR_WORKSPACE_DOMAIN}";
  include /opt/agent-runtime/current/deploy/nginx/snippets/portal-security-headers.conf;

  # Hashed build assets never change; a missing one is a 404, never the SPA entry.
  location /assets/ {
    try_files $uri =404;
    include /opt/agent-runtime/current/deploy/nginx/snippets/portal-security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location = /index.html {
    include /opt/agent-runtime/current/deploy/nginx/snippets/portal-security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }

  # SPA fallback: Portal routes (/activity, /admin/users, ...) load the entry page.
  location / {
    try_files $uri /index.html;
  }

  # The Worker control channel is never reachable from the user network.
  location /api/workers/ {
    return 404;
  }

  location /api/ {
    proxy_pass http://127.0.0.1:${AR_CONTROL_PLANE_PORT};
    include /opt/agent-runtime/current/deploy/nginx/snippets/proxy-control-plane.conf;
  }

  location /auth/ {
    proxy_pass http://127.0.0.1:${AR_CONTROL_PLANE_PORT};
    include /opt/agent-runtime/current/deploy/nginx/snippets/proxy-control-plane.conf;
  }
}

server {
  listen ${AR_PUBLIC_LISTEN}:443 ssl;
  http2 on;
  server_name *.${AR_WORKSPACE_DOMAIN};
  include /opt/agent-runtime/current/deploy/nginx/snippets/logging.conf;
  ssl_certificate /etc/agent-runtime/tls/public.crt;
  ssl_certificate_key /etc/agent-runtime/tls/public.key;

  location / {
    proxy_pass http://127.0.0.1:${AR_GATEWAY_PORT};
    proxy_http_version 1.1;
    # The Gateway matches the exact Host against WORKSPACE_BASE_URL and sets the forwarded
    # headers for pi-web itself; it ignores the client's.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    # Streaming: SSE and WebSocket unbuffered, uploads streamed, no size limit.
    proxy_buffering off;
    proxy_cache off;
    proxy_request_buffering off;
    client_max_body_size 0;
    # Terminal and long Agent runs may be silent for a long time (specs.md Phase 19.13 S4).
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}

server {
  listen ${AR_INTERNAL_LISTEN}:8443 ssl;
  server_name _;
  include /opt/agent-runtime/current/deploy/nginx/snippets/logging.conf;
  ssl_certificate /etc/agent-runtime/tls/internal.crt;
  ssl_certificate_key /etc/agent-runtime/tls/internal.key;
  include /etc/agent-runtime/nginx/worker-allow.conf;
  deny all;

  location = /api/workers/connect {
    proxy_pass http://127.0.0.1:${AR_CONTROL_PLANE_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    # Heartbeats every 10 s keep the channel busy; 5 minutes only cuts a dead one.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  location / {
    return 404;
  }
}

server {
  listen ${AR_INTERNAL_LISTEN}:8444 ssl;
  server_name _;
  include /opt/agent-runtime/current/deploy/nginx/snippets/logging.conf;
  ssl_certificate /etc/agent-runtime/tls/internal.crt;
  ssl_certificate_key /etc/agent-runtime/tls/internal.key;
  include /etc/agent-runtime/nginx/worker-allow.conf;
  deny all;

  # Exactly the inference paths the Worker relay forwards (MODEL_RELAY_ROUTES); key
  # management, users, metrics and the UI of the gateway stay unreachable.
  location ~ ^/v1/(chat/completions|responses|messages|messages/count_tokens)$ {
    limit_except POST {
      deny all;
    }
    proxy_pass http://127.0.0.1:${AR_LITELLM_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    client_max_body_size 32m;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
  }

  location = /health/liveliness {
    limit_except GET {
      deny all;
    }
    proxy_pass http://127.0.0.1:${AR_LITELLM_PORT};
  }

  location / {
    return 404;
  }
}

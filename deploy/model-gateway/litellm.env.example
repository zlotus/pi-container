# Copy to a file outside the repository with mode 0600 (for example
# ~/.config/agent-runtime/litellm.env). Never commit real values.
DEEPSEEK_API_KEY=
# Given only to the Control Plane (MODEL_GATEWAY_MASTER_KEY). Must start with sk-.
LITELLM_MASTER_KEY=
# Appended by tools/dev/init-litellm-db.sh.
# DATABASE_URL=postgresql://litellm:<password>@postgres:5432/litellm
